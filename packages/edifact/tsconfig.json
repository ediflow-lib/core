{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["../core/src/domain/*"],
      "@application/*": ["../core/src/application/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@edifact": ["./src/index.ts"],
      "@edifact/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
