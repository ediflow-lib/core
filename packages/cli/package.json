{
  "name": "@ediflow/cli",
  "version": "0.1.0",
  "description": "EDIFlow Command Line Interface - Parse, Build & Validate EDI messages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ediflow": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "edi",
    "cli",
    "edifact",
    "x12",
    "parser",
    "validator"
  ],
  "author": "EDIFlow Contributors",
  "license": "MIT",
  "dependencies": {
    "@ediflow/core": "*",
    "@ediflow/edifact": "*",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@vitest/coverage-v8": "^1.2.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
